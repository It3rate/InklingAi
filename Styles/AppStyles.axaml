
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:InklingAi.Views"
		xmlns:vm="clr-namespace:InklingAi.ViewModels">

	<Design.PreviewWith>
		<StackPanel>
			<Button>test</Button>
			<Button Classes="image">test2</Button>
		</StackPanel>
	</Design.PreviewWith>
	
	<Style Selector="Label">
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Height" Value="26"/>
		<Setter Property="Margin" Value="4,8,0,-4"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="TextBox">
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="FontSize" Value="14"/>
	</Style>
	
	<Style Selector="Button.image">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>
	<Style Selector="Button.image:pointerover">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="#800000FF"/>
	</Style>
	
	<Style Selector="Image">
		<Setter Property="Margin" Value="1"/>
		<Setter Property="Stretch" Value="Uniform"/>
	</Style>
	
	<Style Selector="Border.image">
		<Setter Property="IsHitTestVisible" Value="True"/>
		<Setter Property="Focusable" Value="True"/>
		<Setter Property="Margin" Value="0"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.image:pointerover">
		<Setter Property="BorderBrush" Value="#D080B0FF"/>
	</Style>
	<Style Selector="Border.image:focus-within">
		<Setter Property="BorderBrush" Value="#D0FF0000"/>
	</Style>
	
</Styles>
