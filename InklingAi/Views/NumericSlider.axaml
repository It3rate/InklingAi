<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="70"
             xmlns:vm="clr-namespace:InklingAi.ViewModels"
             xmlns:controls="clr-namespace:InklingAi.Views"
             x:Class="InklingAi.Views.NumericSlider">

	<UserControl.Resources>
		<vm:StringFormatConverter x:Key="StringFormatConverter"/>
	</UserControl.Resources>
	
	<Grid ColumnDefinitions="Auto, *" Margin="4">
		<TextBox Grid.Column="0" Width="60"
				 TextAlignment="Center"
				 Margin="1,0,6,0" FontWeight="Bold" FontSize="15"
				 HorizontalAlignment="Right" VerticalAlignment="Center">

			<TextBox.Text>
				<MultiBinding Converter="{StaticResource StringFormatConverter}">
					<Binding Path="#_slider.Value" Mode="TwoWay" />
					<Binding Path="NumberFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:NumericSlider}" />
				</MultiBinding>
			</TextBox.Text>
			
		</TextBox>

		<Slider x:Name="_slider" Grid.Column="1" Height="25" VerticalAlignment="Stretch"
				TickPlacement="TopLeft" 
                IsSnapToTickEnabled="True"
				LargeChange="5"
				SmallChange="1"
				Value="{Binding Value, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:NumericSlider}}"
				Minimum="{Binding Minimum, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:NumericSlider}}"
				Maximum="{Binding Maximum, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:NumericSlider}}"
				TickFrequency="{Binding TickFrequency, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:NumericSlider}}"
				>
			<Slider.Resources>
				<x:Double x:Key="SliderHorizontalThumbWidth">22</x:Double>
				<x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
			</Slider.Resources>
		</Slider>
	</Grid>
	
</UserControl>
