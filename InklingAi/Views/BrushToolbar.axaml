<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="40"
			 xmlns:colorpicker="clr-namespace:AvaloniaColorPicker;assembly=AvaloniaColorPicker"
             xmlns:vm="clr-namespace:InklingAi.ViewModels"
             x:Class="InklingAi.Views.BrushToolbar">

  <UserControl.Resources>
    <vm:ColorConverter x:Key="ColorConverter" />
  </UserControl.Resources>

  <Grid x:Name="BrushToolbarGrid" ColumnDefinitions="Auto, 56, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, *">
    
  <Button Grid.Column="0" Classes="image" CommandParameter="BrushSize">
    <Svg Path="/Assets/drawBrushSize.svg" Stretch="Uniform"/>
  </Button>
	<NumericUpDown Grid.Column="1" 
				   Value="{Binding $parent[UserControl].PaintableImage.DrawingData.BrushSize, Mode=TwoWay}" 
				   Width="50" Name="nudBrushSize" 
                Minimum="0" Maximum="60" Increment="2" AllowSpin="True"
			    Spinned="OnValueSpinned"/>
    
  <Button Grid.Column="2" Classes="image" Margin="20,0,0,0" CommandParameter="Transparency">
    <Svg Path="/Assets/drawTransparent.svg" Stretch="Uniform"/>
  </Button>
  <NumericUpDown Grid.Column="3"
				  Value="{Binding $parent[UserControl].PaintableImage.DrawingData.Transparency, Mode=TwoWay}" 
				  Width="56" Name="nudTransparent"
                  Minimum="0" Maximum="255" Increment="20" AllowSpin="True"
				  Spinned="OnValueSpinned"/>
    
  <Button Grid.Column="4" Classes="image" Margin="20,0,0,0"
			CommandParameter="Feather">
    <Svg Path="/Assets/drawFeather.svg" Stretch="Uniform"/>
  </Button>
  <NumericUpDown Grid.Column="5" 
				  Value="{Binding $parent[UserControl].PaintableImage.DrawingData.Feather, Mode=TwoWay}"
				  Width="50" Name="nudFeather"
                  Minimum="0" Maximum="100" Increment="2" AllowSpin="True"
				  Spinned="OnValueSpinned"/>
    
  <Button Grid.Column="6" Classes="image" Margin="20,0,0,0"
			CommandParameter="Color">
    <Svg Path="/Assets/drawColor.svg" Stretch="Uniform"/>
  </Button>
	<Button Grid.Column="8" Classes="image" CommandParameter="Dropper">
      <Svg Path="/Assets/drawDropper.svg" Stretch="Uniform"/>
    </Button>
  </Grid>
  
</UserControl>
