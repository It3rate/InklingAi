<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="50"
             x:Class="InklingAi.Views.AspectButtons">

	<Grid ColumnDefinitions="Auto, Auto, Auto, *">
		<Button Grid.Column="0" Classes="image" Name="_portrait"
				CommandParameter="Portrait" Click="OnButtonClicked">
			<Svg Path="/Assets/portrait.svg" Stretch="Uniform"/>
		</Button>
		<Button Grid.Column="1" Classes="image" Margin="5,5" Name="_square"
				CommandParameter="Square" Click="OnButtonClicked">
			<Svg Path="/Assets/square.svg" Stretch="Uniform"/>
		</Button>
		<Button Grid.Column="2" Classes="image" Margin="0,5" Name="_landscape"
				CommandParameter="Landscape" Click="OnButtonClicked">
			<Svg Path="/Assets/landscape.svg" Stretch="Uniform"/>
		</Button>
	</Grid>

</UserControl>
