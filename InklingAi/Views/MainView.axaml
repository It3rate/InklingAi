<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             xmlns:vm="clr-namespace:InklingAi.ViewModels"
             x:DataType="vm:InklingModel"
		     xmlns:controls="using:InklingAi.Views"
             xmlns:svg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Svg.Skia"
             x:Class="InklingAi.Views.MainView"
             x:CompileBindings="True">
	
  <Design.DataContext> 
	  <vm:InklingModel/>
  </Design.DataContext>
	
	<Grid RowDefinitions="Auto,*,Auto">
		<Grid Grid.Row="0" Height="25">
			<DockPanel>
				<controls:AppMenu />
			</DockPanel>
		</Grid>
		
		
		<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MinWidth="250" MaxWidth="500" />
					<ColumnDefinition Width="260"/>
					<ColumnDefinition Width="2*"/>
					<ColumnDefinition Width="320"/>
				</Grid.ColumnDefinitions>
				<Grid Grid.Column="0">
					<controls:Prompt  x:Name="_prompt"/>
				</Grid>
				<Grid Grid.Column="1">
					<controls:InputControls/>
				</Grid>
      
			<Grid Grid.Column="2" Name="_mainContainer" >
				<Viewbox Name="_viewbox" Stretch="Uniform" Margin="50,20,50,0" VerticalAlignment="Top">
          <Grid ColumnDefinitions="40,Auto" RowDefinitions="38,38, Auto">
            <Label Grid.Row="0" Grid.Column="1" >Influencing Image</Label>
            
            <controls:BrushToolbar
              Grid.Row="1" Grid.Column="1"
							PaintableImage="{Binding InfluenceData.PaintableImage}"
							Background="#303033" Margin="0,0,0,4" />
            
            <controls:DrawingToolbar
              Grid.Row="2" Grid.Column="0"
							PaintableImage="{Binding InfluenceData.PaintableImage}"
							Background="#303033" Margin="0,0,4,0" />

            <Border Grid.Row="2" Grid.Column="2"  
                    Name="_border" Classes="image">	
				<Grid>
          <!--<controls:CompositeImage ImageDataItems="{Binding InfluenceData.CompositedItems}"/>-->
          <controls:SingleImage ImageDataItem="{Binding InfluenceData.FocusedItem}"/>
          <ContentControl Name="_mainPaintableImage" Content="{Binding InfluenceData.PaintableImage}"/>
				</Grid>
			</Border>
              
            
          </Grid>
				</Viewbox>
			</Grid>
      
			<Grid Grid.Column="3">
				<controls:GalleryControl/>
			</Grid>

		</Grid>
		
		
		<Grid Grid.Row="2" Height="20">
			<Label FontSize="12" FontWeight="Light" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,10,0">Status: Ready</Label>
		</Grid>
	</Grid>
</UserControl>
