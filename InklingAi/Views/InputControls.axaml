<UserControl xmlns="https://github.com/avaloniaui"
						xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						xmlns:controls="using:InklingAi.Views"
						xmlns:vm="clr-namespace:InklingAi.ViewModels"
						mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="900"
						x:Class="InklingAi.Views.InputControls">

	<Design.DataContext>
		<vm:InklingModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*" Margin="4">
		<Grid Grid.Row="0" Classes="title">
			<Label>Influencing Images</Label>
		</Grid>
		<Grid Grid.Row="1">
			<ListBox ItemsSource="{Binding InfluenceData.InputItems}" >
				<ListBox.ItemTemplate>
					<DataTemplate>
						<controls:InputControl ItemData="{Binding}"/>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</Grid>

</UserControl>
