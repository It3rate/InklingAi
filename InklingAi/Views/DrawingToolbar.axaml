<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="50"
             xmlns:vm="clr-namespace:InklingAi.ViewModels"
             x:Class="InklingAi.Views.DrawingToolbar">

  <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, *">
    <Button Grid.Row="0" Classes="image"
				CommandParameter="Arrow">
      <Svg Path="/Assets/drawArrow.svg" Stretch="Uniform"/>
    </Button>
    <Button Grid.Row="4" Classes="image"
				CommandParameter="Erase">
      <Svg Path="/Assets/drawErase.svg" Stretch="Uniform"/>
    </Button>
    <Button Grid.Row="6" Classes="image"
				CommandParameter="Paint">
      <Svg Path="/Assets/drawPaint.svg" Stretch="Uniform"/>
    </Button>
    <Button Grid.Row="7" Classes="image"
				CommandParameter="Pen">
      <Svg Path="/Assets/drawPen.svg" Stretch="Uniform"/>
    </Button>
    <Button Grid.Row="8" Classes="image"
				CommandParameter="Resize">
      <Svg Path="/Assets/drawResize.svg" Stretch="Uniform"/>
    </Button>
  </Grid>
  
</UserControl>
