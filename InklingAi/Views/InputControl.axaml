<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="200"
             xmlns:vm="clr-namespace:InklingAi.ViewModels"
             xmlns:controls="clr-namespace:InklingAi.Views"
             x:Class="InklingAi.Views.InputControl">

	<Design.DataContext>
		<vm:DesignTimeInputItem/>
	</Design.DataContext>

	<Expander Name="_expander" PointerPressed="OnGotFocus"
            Header="{Binding InputTitle}" IsExpanded="{Binding IsActive}">
		<Grid ColumnDefinitions="Auto,*">
      <!--<Grid RowDefinitions="*,*,*" Grid.Column="0" Margin="4,0,0,0">
				<Button Grid.Row="0" Margin="0,4" Width="60" >Active</Button>
				<Button Grid.Row="1" Margin="0,4" Width="60" >Show</Button>
				<Button Grid.Row="2" Margin="0,4" Width="60" >Edit</Button>
			</Grid>-->
			<controls:SingleImage Grid.Column="1" Margin="2" Width="160" 
                            Data="{Binding}"/>
		</Grid>
	</Expander>
</UserControl>					

      