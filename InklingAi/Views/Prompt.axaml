<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:controls="using:InklingAi.Views"
			 xmlns:vm="clr-namespace:InklingAi.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="800"
             x:Class="InklingAi.Views.Prompt">

	<Design.DataContext>
		<vm:InklingModel />
	</Design.DataContext>
	
	<UserControl.Resources>
		<vm:PercentageConverter x:Key="PercentageConverter" />
		<vm:IntStringConverter x:Key="IntStringConverter" />
	</UserControl.Resources>

	<Grid RowDefinitions=
			"Auto,*,Auto,*,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
			Margin="4">
		<Grid Grid.Row="0" Classes="title">
			<Label>Image Description</Label>
		</Grid>
		<Grid Grid.Row="1" >
			<TextBox TextWrapping="Wrap" Text="{Binding SDConfig.Prompt}"/>
		</Grid>
		<Grid Grid.Row="2" Classes="title">
			<Label>Style</Label>
		</Grid>
		<Grid Grid.Row="3" >
			<TextBox TextWrapping="Wrap" Text="{Binding SDConfig.StylePrompt}"/>
		</Grid>
		<Grid Grid.Row="4" Classes="title">
			<Label>Unwanted Attributes</Label>
		</Grid>
		<Grid Grid.Row="5">
			<TextBox TextWrapping="Wrap" Text="{Binding SDConfig.NegativePrompt}" />
		</Grid>
		
		<Grid Grid.Row="6" Classes="title">
			<Label>Aspect Ratio</Label>
		</Grid>
		<Grid Grid.Row="7" Height="50" Margin="4,0,0,0">
			<controls:AspectButtons Grid.Column="0" Command="{Binding ChangeAspectSizeCommand}" />
		</Grid>

		<Grid Grid.Row="8" Classes="title">
			<Label>Sampling Steps</Label>
		</Grid>
		<Grid Grid.Row="9" Height="40">
			<Grid ColumnDefinitions="*">
				<controls:NumericSlider Grid.Column="1"
					Value="{Binding SDConfig.NumInferenceSteps}"
					Minimum="0"
					Maximum="50"
					TickFrequency="1"
				/>
			</Grid>
		</Grid>

		<Grid Grid.Row="10"  Classes="title">
			<Label>Prompt Weight</Label>
		</Grid>
		<Grid Grid.Row="11"  Height="40">
			<Grid ColumnDefinitions="*">
				<controls:NumericSlider Grid.Column="1"
					Value="{Binding SDConfig.GuidanceScale}"
					Minimum="0"
					Maximum="12"
					TickFrequency="0.5"
					NumberFormat="0.0"
				/>
			</Grid>
		</Grid>

		<Grid Grid.Row="12" Classes="title">
			<Label>Image Preservation</Label>
		</Grid>
		<Grid Grid.Row="13"  Height="40">
			<Grid ColumnDefinitions="*">
				<controls:NumericSlider Grid.Column="1"
					Value="{Binding SDConfig.ImagePreservation, 
					Converter={StaticResource PercentageConverter}}"
					Minimum="0"
					Maximum="100"
					TickFrequency="1"
					NumberFormat="0'%'"/>
			</Grid>
		</Grid>
		<Grid Grid.Row="14"  Margin="4" Height="64">
			<Grid ColumnDefinitions="Auto,*">
				<ToggleButton Grid.Column="0" Classes="image_button" Margin="6"  IsThreeState="False"
							  Name="_seed" IsChecked="{Binding SDConfig.SeedUnlocked}">
					<Panel>
						<Image Classes="seed_locked" Source="/Assets/unlock_64.png" />
						<Image Classes="seed_unlocked" Source="/Assets/lock_64.png" />
					</Panel>
				</ToggleButton>

				<Grid Grid.Column="1" RowDefinitions="Auto,Auto" Margin="2">
					<Grid Grid.Row="0" ColumnDefinitions="*,*">
						<Label Grid.Column="0" Margin="0,4,0,0"> Seed </Label>
						<Label Grid.Column="1" Margin="0,4,0,0"> Diffusion </Label>
					</Grid>
					<Grid Grid.Row="1" ColumnDefinitions="*,*">
						<TextBox Grid.Column="0" Name="txSeed"
								 Text="{Binding SDConfig.Seed, Converter={StaticResource IntStringConverter}}"
								 TextChanging = "OnNumericOnly"
								 VerticalAlignment="Top" HorizontalAlignment="Left"
								 Height="30" />
						<ComboBox Grid.Column="1" SelectedIndex="0" 
								  VerticalAlignment="Top" HorizontalAlignment="Left"
								  Height="30">
							<ComboBoxItem>
								<TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
									Textured
								</TextBlock>
							</ComboBoxItem>
							<ComboBoxItem>
								<TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
									Smooth
								</TextBlock>
							</ComboBoxItem>
						</ComboBox>
					</Grid>
				</Grid>
				
			</Grid>
		</Grid>
		
		
		<Grid Grid.Row="15" Height="70">
			<Grid ColumnDefinitions="*" VerticalAlignment="Bottom">
				<Button Grid.Column="0" Background="Transparent" BorderThickness="1" Margin="8" 
						Command="{Binding OnGenerate}">
					<Image Source="/Assets/generate.png"/>
				</Button>
			</Grid>
		</Grid>

	</Grid>
	
</UserControl>
