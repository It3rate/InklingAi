<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:controls="using:InklingAi.Views"
			 xmlns:vm="clr-namespace:InklingAi.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="InklingAi.Views.Prompt">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid RowDefinitions=
			"Auto,*,Auto,*,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
			Margin="4">
		<Grid Grid.Row="0" Classes="title">
			<Label>Image Description</Label>
		</Grid>
		<Grid Grid.Row="1" >
			<TextBox TextWrapping="Wrap">A baltimore oriole on a birthday card.</TextBox>
		</Grid>
		<Grid Grid.Row="2" Classes="title">
			<Label>Style</Label>
		</Grid>
		<Grid Grid.Row="3" >
			<TextBox TextWrapping="Wrap">Victorian illustration, decorative border, style of Alphonse Mucha, Turner</TextBox>
		</Grid>
		<Grid Grid.Row="4" Classes="title">
			<Label>Unwanted Attributes</Label>
		</Grid>
		<Grid Grid.Row="5">
			<TextBox TextWrapping="Wrap">lowres, error, cropped, worst quality, low quality, jpeg artifacts, out of frame, watermark, signature</TextBox>
		</Grid>
		
		<Grid Grid.Row="6" Classes="title">
			<Label>Aspect Ratio</Label>
		</Grid>
		<Grid Grid.Row="7" Height="50" Margin="4,0,0,0">
			<controls:AspectButtons Grid.Column="0"/>
		</Grid>

		<Grid Grid.Row="8" Classes="title">
			<Label>Sampling Steps</Label>
		</Grid>
		<Grid Grid.Row="9" Height="40">
			<Grid ColumnDefinitions="*">
				<controls:NumericSlider Grid.Column="1"
					Value="21"
					Minimum="0"
					Maximum="50"
					TickFrequency="1"
				/>
			</Grid>
		</Grid>

		<Grid Grid.Row="10"  Classes="title">
			<Label>Prompt Weight</Label>
		</Grid>
		<Grid Grid.Row="11"  Height="40">
			<Grid ColumnDefinitions="*">
				<controls:NumericSlider Grid.Column="1"
					Value="7.5"
					Minimum="0"
					Maximum="12"
					TickFrequency="0.5"
					NumberFormat="0.0"
				/>
			</Grid>
		</Grid>

		<Grid Grid.Row="12" Classes="title">
			<Label>Image Preservation</Label>
		</Grid>
		<Grid Grid.Row="13"  Height="40">
			<Grid ColumnDefinitions="*">
				<controls:NumericSlider Grid.Column="1"
					Value="35"
					Minimum="0"
					Maximum="100"
					TickFrequency="1"
					NumberFormat="0'%'"/>
			</Grid>
		</Grid>
		<Grid Grid.Row="14"  Margin="4" Height="64">
			<Grid ColumnDefinitions="Auto,*">
				<Image Grid.Column="0" Margin="6" Source="/Assets/unlock_64.png" />

				<Grid Grid.Column="1" RowDefinitions="Auto,Auto" Margin="2">
					<Grid Grid.Row="0" ColumnDefinitions="*,*">
						<Label Grid.Column="0" Margin="0,4,0,0"> Seed </Label>
						<Label Grid.Column="1" Margin="0,4,0,0"> Diffusion </Label>
					</Grid>
					<Grid Grid.Row="1" ColumnDefinitions="*,*">
						<TextBox Grid.Column="0" 
								 VerticalAlignment="Top" HorizontalAlignment="Left"
								 Height="30" Width="90">123456</TextBox>
						<ComboBox Grid.Column="1" SelectedIndex="0" 
								  VerticalAlignment="Top" HorizontalAlignment="Left"
								  Height="30" Width="90">
							<ComboBoxItem>
								<TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
									Textured
								</TextBlock>
							</ComboBoxItem>
							<ComboBoxItem>
								<TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
									Smooth
								</TextBlock>
							</ComboBoxItem>
						</ComboBox>
					</Grid>
				</Grid>
				
			</Grid>
		</Grid>
		
		
		<Grid Grid.Row="15" Height="70">
			<Grid ColumnDefinitions="*" VerticalAlignment="Bottom">
				<Image Grid.Column="0" Margin="8" Source="/Assets/generate.png"/>
			</Grid>
		</Grid>

	</Grid>
	
</UserControl>
