<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="800"
             xmlns:vm="clr-namespace:InklingAi.ViewModels"
             xmlns:controls="clr-namespace:InklingAi.Views"
             x:Class="InklingAi.Views.GalleryControl"
             x:DataType="vm:MainViewModel" >

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<UserControl.Resources>
		<vm:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Image">
			<Setter Property="IsHitTestVisible" Value="True"/>
			<Setter Property="Focusable" Value="True"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="Border.image">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Border.image:pointerover">
			<Setter Property="BorderBrush" Value="#D080B0FF"/>
		</Style>
		<Style Selector="Border.image:focus-within">
			<Setter Property="BorderBrush" Value="#D0FF0000"/>
		</Style>
		
		<Style Selector="ListBox">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter:pointerover">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter:selected">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter:focus-within">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter:selected:pointerover">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
	</UserControl.Styles>

	
	<Grid RowDefinitions="Auto, *">
		<Border Classes="image">
		<Image Grid.Row="0"
			Source="{Binding MainImagePath,Converter={StaticResource PathToBitmapConverter}}"
			Width="{Binding Width, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:GalleryControl}}"
			Margin="0,0,0,4"/>
		</Border>
		
		<ListBox Grid.Row="1"
			Name="lbGallery"
			ItemsSource="{Binding ImagePairPaths}"
			ScrollViewer.HorizontalScrollBarVisibility="Hidden"
			ScrollViewer.VerticalScrollBarVisibility="Hidden">

			<ListBox.ItemTemplate>
				<DataTemplate>

					<StackPanel Orientation="Horizontal" Background="Transparent">
						<Border Classes="image">
						<Image Source="{Binding Path=[0], Converter={StaticResource PathToBitmapConverter}}"
							   Width="{Binding HalfWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:GalleryControl}}"
							   PointerPressed="OnImagePointerPressed"
							   PointerMoved="OnImagePointerMoved"
							   PointerReleased="OnImagePointerReleased"
							   />
						</Border>
						<Border Classes="image">
						<Image Source="{Binding Path=[1], Converter={StaticResource PathToBitmapConverter}}"
							   Width="{Binding HalfWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:GalleryControl}}"
							   PointerPressed="OnImagePointerPressed"
							   PointerMoved="OnImagePointerMoved"
							   PointerReleased="OnImagePointerReleased"
							   IsHitTestVisible="True"
							   />
						</Border>
						<Border Classes="image">
						<Image Source="{Binding Path=[2], Converter={StaticResource PathToBitmapConverter}}"
							   Width="{Binding HalfWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:GalleryControl}}"
							   PointerPressed="OnImagePointerPressed"
							   PointerMoved="OnImagePointerMoved"
							   PointerReleased="OnImagePointerReleased"
							   IsHitTestVisible="True"
							   />
						</Border>
					</StackPanel>

					<!--<StackPanel Orientation="Horizontal">
					<ItemsControl ItemsSource="{Binding}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Image Source="{Binding Converter={StaticResource PathToBitmapConverter}}"
										Stretch="Uniform"
										Width="{Binding HalfWidth, 
												RelativeSource={RelativeSource FindAncestor, 
												AncestorType=controls:GalleryControl}}"
										Margin="2"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>-->

				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>
	</Grid>

</UserControl>
