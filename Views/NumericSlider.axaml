<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="40"
             x:Class="InklingAi.Views.NumericSlider">

	<Grid ColumnDefinitions="Auto, *" Margin="4">
		<TextBlock Grid.Column="0" Width="40"
				 Text="{Binding #slider.Value, StringFormat={}{0:F1}}}" TextAlignment="Center"
				 Margin="1,0,6,0" FontWeight="Bold" FontSize="15" 
				 HorizontalAlignment="Right" VerticalAlignment="Center"/>
		
		<Slider Grid.Column="1"  x:Name="slider" Height="25"
				Minimum="0" Maximum="100" 
				TickFrequency="10" TickPlacement="TopLeft"
				VerticalAlignment="Top">
				<Slider.Resources>
					<x:Double x:Key="SliderHorizontalThumbWidth">22</x:Double>
					<x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
				</Slider.Resources>
		</Slider>
	</Grid>
</UserControl>
