<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="40"
             xmlns:vm="clr-namespace:InklingAi.ViewModels"
             x:Class="InklingAi.Views.NumericSlider">

	<UserControl.Resources>
		<vm:DoubleStringConverter x:Key="DoubleStringConverter"/>
	</UserControl.Resources>
	
	<Grid ColumnDefinitions="Auto, *" Margin="4">
		<TextBox Grid.Column="0" Width="50"
				 Text="{Binding #_slider.Value, Mode=TwoWay, 
				 Converter={StaticResource DoubleStringConverter}, 
				 }"
				 TextAlignment="Center"
				 Margin="1,0,6,0" FontWeight="Bold" FontSize="15"
				 HorizontalAlignment="Right" VerticalAlignment="Center"/>

		<Slider  x:Name="_slider" Grid.Column="1" Height="25"
				Minimum="0" Maximum="100"
				TickFrequency="10" TickPlacement="TopLeft" 
				VerticalAlignment="Top">
			<Slider.Resources>
				<x:Double x:Key="SliderHorizontalThumbWidth">22</x:Double>
				<x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
			</Slider.Resources>
		</Slider>
	</Grid>
</UserControl>
