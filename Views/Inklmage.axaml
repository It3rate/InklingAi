<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InklingAi.ViewModels"
             xmlns:controls="clr-namespace:InklingAi.Views"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="InklingAi.Views.InkImage">

	<UserControl.Resources>
		<vm:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Image">
			<Setter Property="IsHitTestVisible" Value="True"/>
			<Setter Property="Focusable" Value="True"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="Border">
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="Border.image">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.image:pointerover">
			<Setter Property="BorderBrush" Value="#D080B0FF"/>
		</Style>
		<Style Selector="Border.image:focus-within">
			<Setter Property="BorderBrush" Value="#D0FF0000"/>
		</Style>
	</UserControl.Styles>
	
	<Border Name="__borderOuter">
		<Border Name="__border" Classes="image" 
				DragDrop.AllowDrop="True">
			<Image  Name="__image"
					Source="{Binding Source, 
						RelativeSource={RelativeSource FindAncestor, AncestorType=controls:InkImage},
						Converter={StaticResource PathToBitmapConverter}}"
					Stretch="Uniform"
					PointerPressed="OnImagePointerPressed"
					PointerMoved="OnImagePointerMoved"
					PointerReleased="OnImagePointerReleased"
		/>
		</Border>
	</Border>
	
</UserControl>
